{
  "name": "@2025-personal-portfolio/monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "A monorepo with packages for a personal portfolio website.",
  "type": "module",
  "scripts": {
    "build:common": "pnpm --filter common run build",
    "build:openapi": "pnpm --filter openapi-generator run build",
    "dev:frontend": "pnpm --filter frontend run dev",
    "dev:backend": "pnpm --filter backend run dev",
    "dev:discord": "pnpm --filter discord run dev",
    "build:frontend": "pnpm --filter frontend run build",
    "lint:frontend": "eslint -c packages/frontend/.eslintrc.lint.json packages/frontend/src/ --ext .ts,.tsx --fix && stylelint -c packages/frontend/.stylelintrc.json packages/frontend/src/**/*.css --fix",
    "preview:frontend": "pnpm --filter frontend run preview"
  },
  "author": "Christie Leung",
  "license": "ISC",
  "dependencies": {
    "builder-pattern": "^2.2.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.57.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-no-only-tests": "^3.3.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.19",
    "eslint-plugin-unused-imports": "^3.2.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.4.3",
    "npm-run-all": "^4.1.5",
    "openapi-generator-plus": "2.18.0",
    "postcss": "^8.5.2",
    "postcss-lit": "^1.2.0",
    "prettier": "^3.5.1",
    "rimraf": "^6.0.1",
    "stylelint": "^16.14.1",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-prettier": "^5.0.3",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
