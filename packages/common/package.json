{
  "name": "@2025-personal-portfolio/common",
  "version": "1.0.0",
  "description": "Common utilities and types for the 2025 personal portfolio monorepo.",
  "main": "src/",
  "files": [
    "dist"
  ],
  "scripts": {
    "barrels": "barrelsby --config .barrelsby.json",
    "clean": "rimraf dist/",
    "dev": "onchange 'src/**/*.ts' -- pnpm run compile",
    "prebuild": "pnpm run clean && pnpm run generate && pnpm run barrels",
    "build": "pnpm run prebuild && pnpm run compile",
    "compile": "tsc --project tsconfig.compile.json && tsc-alias -p tsconfig.compile.json",
    "lint": "stylelint src/**/*.css --fix",
    "preview": "vite preview",
    "generate": "pnpm run generate:id",
    "generate:id": "node generators/ids.js"
  },
  "keywords": [],
  "author": "Christie Leung",
  "license": "ISC",
  "dependencies": {
    "@tsed/schema": "^8.15.0",
    "@types/react": "^19.1.8",
    "barrelsby": "^2.8.1",
    "dayjs": "^1.11.13",
    "fs": "0.0.1-security",
    "handlebars": "^4.7.8",
    "ismobilejs": "^1.1.1",
    "lodash.debounce": "^4.0.8",
    "lodash.get": "^4.4.2",
    "lodash.isequal": "^4.5.0",
    "lodash.isequalwith": "^4.4.0",
    "lodash.sortby": "^4.7.0",
    "lodash.startcase": "^4.4.0",
    "path": "^0.12.7",
    "react": "^19.1.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.20",
    "@types/lodash.debounce": "^4.0.9",
    "@types/lodash.get": "^4.4.9",
    "@types/lodash.isequal": "^4.5.8",
    "@types/lodash.sortby": "^4.7.9",
    "@types/lodash.startcase": "^4.4.9",
    "@types/node": "^24.2.1"
  }
}
